# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is the one that has to be readable in a
# fresh clone. `.env*` above had been silently swallowing it, which is why
# AGENTS.md pointed at a file that had never once existed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env

# Playwright
/test-results/
/playwright-report/

# Generated by `pnpm screenshots`
/screenshots/

# Playwright saved sessions
/.auth/

# Worktrees agents work in; never part of the repository.
.claude/worktrees/

# The full-resolution bot portraits as generated. The 280px faces cut from them
# by `pnpm art:faces` are what the site serves and what is committed; the
# sources are two megabytes each and twenty of them would be forty megabytes of
# history for files nothing reads.
public/art/bots/*.png
public/art/bots/*.webp
public/art/bots/src-*/
