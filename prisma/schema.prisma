// Game history for gomoku.
//
// Every finished game is recorded once, with its stones in order, so a game can
// be replayed move by move long after the browser tab that played it is gone.
// The board itself is never stored: a board is exactly the settings plus the
// move list, and storing both would let them disagree.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Migrations need a direct connection; a pooled URL (Neon, PgBouncer) goes in DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// How a game ended. `abandoned` is a game that was recorded before anyone won.
enum GameResult {
  black
  white
  draw
  abandoned
}

/// Whether a game is still being played or is over.
enum GameLifecycle {
  active
  finished
}

model Game {
  /// Eight characters in two blocks — k3m9-p2qx — made by makeGameId and
  /// checked free before use. Not a generated default: a game's id is in
  /// every address it has, so it is chosen deliberately, not by the client.
  id        String   @id
  playedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  status GameLifecycle @default(finished)

  /// Seat keys. There is no sign-in here, so holding a seat's token *is* the
  /// claim to that seat: whoever has the link plays that colour. They are
  /// generated per game and never derived from anything guessable.
  blackToken String @unique @default(cuid())
  whiteToken String @unique @default(cuid())
  /// When each seat's link was first used, or null while the seat is still to
  /// be given out. A seat's link is only shown while it is null: the token is
  /// the whole credential, so a link that is still on screen after somebody
  /// has taken the seat is that player's credential on somebody else's
  /// display.
  blackClaimedAt DateTime?
  whiteClaimedAt DateTime?

  /// Display names, free text. Blank means the seat was anonymous.
  blackName String @default("")
  whiteName String @default("")

  /// The member holding each seat, by opaque id, when a signed-in player took
  /// it. A seat taken from a scanned link with no sign-in has none, and is
  /// known only to the browser holding its token.
  ///
  /// The id and not the address: a seat is held by a person, and an address
  /// is neither a name nor a key here.
  blackMemberId String?
  whiteMemberId String?

  /// The settings the game was played under, mirrored from GameSettings.
  size      Int
  winLength Int
  variant   String
  obstacles String
  opener    String
  /// Opening protocol, see OpeningRule. Games recorded before it existed are "free".
  opening   String @default("free")
  /// A per-colour handicap, see Handicap, or null for none.
  handicap  Json?
  /// The random seed the game was created with: dead and hot squares, piece queues.
  seed      Int    @default(0)

  /// Per-move time limit for a shared game, in milliseconds; null for none.
  /// Under the whole-game clock this is each side's budget for the whole game.
  moveTimeMs     Int?
  /// "move": the limit is per move and resets each turn. "game": one budget a side for the whole game.
  clockMode      String     @default("move")
  /// Time each side has left under the whole-game clock, in milliseconds; null under the per-move clock.
  blackTimeMs    Int?
  whiteTimeMs    Int?
  /// When the colour to move must have moved by; the server sets it on every move.
  deadlineAt     DateTime?
  /// Courtesy time the waiting side gave the mover for this move, in milliseconds. Cleared on the move.
  extraMs        Int        @default(0)
  /// Whether the result moves ratings. Off makes a friendly game between rated players.
  rated          Boolean    @default(true)
  /// What running out of time costs: "turn" (graceful) or "game".
  timeoutPenalty String    @default("turn")
  /// When the last move landed, so a deadline can be computed on the server.
  lastMoveAt     DateTime?
  /// Consecutive turns each colour has forfeited to the clock. Three lose the game.
  blackForfeits  Int       @default(0)
  whiteForfeits  Int       @default(0)

  /// Whether a seat may give the game up. The host decides when setting it up.
  allowResign Boolean   @default(true)
  /// The length the players agreed to, see DrawLimit: "none" plays it out,
  /// "half" and "threeQuarters" call it a draw at that share of the board's
  /// points with nobody having won. Games recorded before it existed are
  /// "none", which is how they were played.
  drawLimit   String    @default("none")
  /// A seat anyone may take, posted on the games page: "white" while it waits,
  /// null once somebody has sat down or when the game was never open.
  /// Each seat's private read on its own play, given once the game is over: "up" or "down".
  blackVerdict String?
  whiteVerdict String?
  /// A seat may hide a finished regular game from its own public list. Totals still count it.
  hiddenByBlack Boolean @default(false)
  hiddenByWhite Boolean @default(false)
  openSeat    String?
  /// When the open seat was posted, so the board lists the newest first.
  openedAt    DateTime?

  /// How the game ended — and, until it has, a placeholder.
  ///
  /// A game is born `status: active, result: abandoned`, and the result is
  /// overwritten when it finishes. So this column says two different things:
  /// "ended without a result" and "has not got one yet". `status` is what
  /// tells them apart, and nothing here means anything until it says finished.
  ///
  /// The three states anybody actually means are `finished` with a real
  /// result (played out), `active` (being played), and `finished` with
  /// `abandoned` (ended without a result) — the last of which had never once
  /// happened on production when this was written.
  result     GameResult
  /// Set for a decisive game, null for a draw or an abandoned one.
  winner     String?
  moveCount  Int

  /// The engine's verdict on the position, written by whoever last settled it:
  /// "playing", "won" or "draw" — see GAME_STATUS. NULL means nothing has ever
  /// written one, which is NOT the same as "it is over": a reader seeing null
  /// replays the moves, as every reader did before these columns existed.
  ///
  /// It is a second status rather than a reading of `status` because the two
  /// answer different questions. `status` is what the row was filed as;
  /// this is what the engine makes of the stones. They disagree exactly where
  /// it matters — a Reversi board that filled up ends the game with nobody
  /// having written anything down, and `settleEnded` exists for that.
  settledStatus String?
  /// The colour to move in that settled position, or null where nobody is to
  /// move. Only ever read alongside `settledStatus`: on its own, null says
  /// both "the game is over" and "nobody has looked", which is the one thing
  /// it must never be asked. Written only by `settledTurn`.
  settledToPlay String?
  /// Wall-clock length, when the client tracked it.
  durationMs Int?

  moves     Move[]

  gifts     TimeGift[]
  reactions Reaction[]
  applause  Applause[]

  /// Listing sorts by these; a compound index covers the default ordering.
  @@index([playedAt])
  @@index([result, playedAt])
  @@index([size, playedAt])
  @@index([status, updatedAt])
  @@index([openSeat, openedAt])
  @@index([blackMemberId])
  @@index([whiteMemberId])
}

model Move {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  /// 1-based, matching the move numbers shown on the board.
  number         Int
  row            Int
  col            Int
  stone          String
  /// "place" for an ordinary stone, "skip" for a deliberately wasted turn,
  /// "move" for a piece stepping from (fromRow, fromCol) to (row, col).
  kind           String   @default("place")
  fromRow        Int?
  fromCol        Int?
  /// The quarter turn that ended this move in a twist game: which quadrant, which way.
  twistQuadrant  Int?
  twistClockwise Boolean?
  /// The cells a multi-cell piece covered, with their colours, on "piece" kinds.
  cells          Json?
  /// When the move landed. Existing rows get the moment this column was
  /// added, not their true historical time — there was nowhere to read
  /// that from. Every move from here on is real.
  createdAt      DateTime @default(now())

  @@unique([gameId, number])
  @@index([gameId, number])
}

/// An invitation to play.
///
/// There are no accounts, so this is how someone gets in: the operator mints a
/// three-word code and hands it over. Redeeming exchanges the phrase once for
/// a signed cookie, so the phrase stops being the credential the moment it is
/// used — which is what lets it be short enough to say out loud.
model InviteCode {
  /// The normalised phrase, e.g. "hoshi-kuma-nami". Lowercase, hyphenated.
  code       String    @id
  /// The operator who minted it, for the question "who let them in".
  createdBy  String
  createdAt  DateTime  @default(now())
  /// Null never expires.
  expiresAt  DateTime?
  /// Zero means unlimited.
  maxUses    Int       @default(0)
  uses       Int       @default(0)
  /// Revoking beats every other field; a revoked code is dead immediately.
  revoked    Boolean   @default(false)
  /// Free text so the operator can remember who it was for.
  note       String    @default("")
  lastUsedAt DateTime?

  @@index([createdAt])
  @@index([revoked, expiresAt])
}

/// An emoji one player sent the other during a shared game.
///
/// The emoji comes from a fixed list, never free text, so nothing a stranger
/// types is ever shown to another player. `moveNumber` is the move it was a
/// reaction to, or null for a general remark.
/// A public mark of appreciation on a finished game.
///
/// Anybody who can see the game may leave one, not only the two who played
/// it, and each member leaves at most one — so the tally counts people, not
/// clicks. There is deliberately no opposite: a game nobody marks stays
/// quiet rather than showing a score against it.
model Applause {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// The member who left it, by address.
  member    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([gameId, member])
  @@index([gameId])
}

model Reaction {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// The colour that sent it.
  stone      String
  emoji      String
  /// A short message sent with the move, if any.
  text       String?
  moveNumber Int?
  createdAt  DateTime @default(now())

  @@index([gameId, createdAt])
}

/// A player, known by name. There are no accounts, so the name is the
/// identity, folded to lower case: whoever plays as "Aki" is Aki.
model Player {
  /// The name as folded for matching.
  key        String   @id
  /// The member this record belongs to, by opaque id.
  ///
  /// A rating is earned by a person, not by a spelling, so this is what it
  /// hangs off; the folded name stays the primary key for now and moves in a
  /// later step. Null where no account has ever been attached — a name typed
  /// into a game at one screen and never claimed by anybody.
  memberId   String?
  /// The name as last typed, for display.
  name       String
  /// The rating earned against other people, which is what this site has
  /// always meant by a rating: every page that shows "a rating" shows this.
  /// It is deliberately not renamed. Games against the computer are kept in
  /// their own pool below and never touch it.
  rating     Int      @default(1600)
  ratedGames Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  /// The rating earned against the computer players, in a pool of its own.
  ///
  /// Two pools rather than one, because a computer opponent is always
  /// available and always rated: with one pool every rating on the site would
  /// drift towards wherever the three graded players happened to settle, and a
  /// ladder of people would stop being a ladder of people. Separating them
  /// answers that outright rather than by capping or discounting anything, and
  /// both sides of a game against the computer move in the same pool — the
  /// player's and the computer's own — exactly as a rated game should.
  computerRating     Int @default(1600)
  computerRatedGames Int @default(0)
  computerWins       Int @default(0)
  computerLosses     Int @default(0)
  computerDraws      Int @default(0)

  /// The run this name is on: consecutive results of the same kind, most
  /// recent first. See `rating/streak.ts`, which owns the rule — a draw is
  /// its own streak, and ends a run of wins rather than being skipped.
  ///
  /// A COLUMN RATHER THAN A QUERY, and that is the whole design. Reading a
  /// streak back from the games would mean a player's history per row, on a
  /// page listing every member — the fault taken off the landing page in
  /// 0.139.0, where drawing eight games read 2,508 move rows. Whatever
  /// records a result has already read this row, so the run so far is in its
  /// hands: `recordResult` carries it forward and nothing reads a game back.
  ///
  /// THREE SCOPES, BECAUSE THEY ARE THREE DIFFERENT NUMBERS. `people` is the
  /// ladder's run, `computer` the run against the programs, and `rated` both
  /// pools together — which is what the members list and a member's own
  /// headline count. They cannot be derived from each other: a run across two
  /// pools depends on the order the games interleave in, which neither pool's
  /// own run records.
  ///
  /// NULL MEANS NOBODY HAS FINISHED A GAME, not a run of nought. The kind and
  /// the count are only ever believed together, which is what keeps a
  /// nullable pair honest — see `Game.settledStatus` for the same shape.
  /// Spelled out rather than following the bare-name-means-people convention
  /// the rating columns use, because `ratedStreak` is the one that does NOT
  /// mean the people pool and would be misread by whoever knows this schema best.
  peopleStreakKind    String?
  peopleStreakCount   Int @default(0)
  computerStreakKind  String?
  computerStreakCount Int @default(0)
  ratedStreakKind     String?
  ratedStreakCount    Int @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([rating])
  @@index([computerRating])
  @@index([memberId])
}

/// One player's standing in a single game.
///
/// The global ladder on Player ranks every name against every other whatever
/// they played, which puts a Renju specialist and a Notakto specialist on one
/// list. This table keeps a separate Elo per variant so each game has its own
/// ranking. Both are maintained: recordResult writes the global row and the
/// variant row together.
///
/// Expect these to look thin for a while. Only shared games are rated — games
/// at one screen are filed, never rated — so split across every variant, most
/// standings sit at "unrated" until a game has been played a few times.
model PlayerVariantRating {
  /// The folded name, matching Player.key.
  key        String
  /// The member this standing belongs to, by opaque id. See Player.memberId.
  memberId   String?
  /// The RuleVariant the standing is for.
  variant    String
  /// The name as last typed, so a board can render without reading Player.
  name       String   @default("")
  rating     Int      @default(1600)
  ratedGames Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  /// The same two pools as on Player, per game. See Player.computerRating.
  computerRating     Int @default(1600)
  computerRatedGames Int @default(0)
  computerWins       Int @default(0)
  computerLosses     Int @default(0)
  computerDraws      Int @default(0)
  /// This standing's run, per pool. See Player.peopleStreakKind for the rule
  /// and the reason it is stored rather than counted.
  ///
  /// Two scopes here and three on Player, deliberately. Every table of
  /// per-game standings on this site is already one row per game per pool —
  /// a player who has played Renju against both shows two lines, because
  /// adding them is the one thing the pools exist to forbid — so a
  /// both-pools streak here would be a number no page could honestly print.
  ///
  /// AND NO `played` SCOPE EITHER, which is a decision rather than an
  /// oversight: `Member.playedStreakKind` has one and this does not. Only two
  /// places on the site show a per-game record over EVERY game — the "By game"
  /// table on a player's page and "Your record at X" under a game's ladder —
  /// and both are about ONE person, so both already hold that person's games
  /// and read the run out of the same pass (`fetchPlayerRecord().byVariant`).
  /// There is no LIST of per-game all-games records anywhere, which is the only
  /// thing a stored run would be for. Adding one would mean a write per name
  /// per variant on every unrated finish to feed a figure nothing reads.
  peopleStreakKind    String?
  peopleStreakCount   Int @default(0)
  computerStreakKind  String?
  computerStreakCount Int @default(0)
  updatedAt  DateTime @updatedAt

  @@id([key, variant])
  /// The per-game leaderboard reads this: one variant, best first.
  @@index([variant, rating])
  @@index([variant, computerRating])
  /// A player's page reads every standing they hold.
  @@index([key])
  @@index([memberId])
}

/// Somebody who has been let in by name: a Google account that once redeemed
/// an invite, or that the operator admitted. There is no password here — Google
/// proves the address, this row says the address is welcome — and there is no
/// separate account to create: the first sign-in is the registration.
model Member {
  /// The member's own name for the database: opaque, given once, and never
  /// derived from anything anybody typed. The rating, the record and the
  /// seats all hang off this, so a rename moves nothing and an address is no
  /// part of any key. It identifies but does not prove — knowing an id is not
  /// being somebody; see memberId.ts.
  id          String   @id
  /// How they sign in, when they ever have. Null for a record kept for
  /// somebody who never held an account here: those people have no address,
  /// and until this stopped being the key they had to be given a made-up one.
  email       String?  @unique
  /// Why this row may never be claimed by a real login: "kept-record" for a
  /// history meant to stand as it is, "seed" for a made-up row that must not
  /// be picked up by a real signup. Null means there is no reason it cannot.
  unclaimableBecause String?
  /// The member's four-word phrase, hashed. Null for an account that has not
  /// set one, which is most of them.
  ///
  /// A SECOND CREDENTIAL ON THE SAME ACCOUNT, alongside `email`, and the two
  /// are independent: either may be added at any time, in any order, and an
  /// account must keep at least one. That is what lets somebody with no
  /// address hold an account, and lets a member who has already played gain a
  /// phrase without anything about their row moving — same id, same games,
  /// same standing. See `lib/phrase/credentials.ts`, which is the whole rule.
  ///
  /// IT IS A PASSWORD. It proves who somebody is on a device where somebody
  /// else is signed in, and on a device where nobody is, so it is stored the
  /// way a password is: scrypt, salted per row, and never recoverable. The
  /// words themselves are NOT stored, no API returns this column, and nothing
  /// logs it. Which four words were offered by the picker is not stored either
  /// — those are drawn per request and exist only in a signed ticket.
  phraseHash  String?
  /// When the phrase was last set, or null when there has never been one.
  ///
  /// The only thing the member is shown about their own phrase, because it is
  /// the only thing that can be shown: a properly hashed phrase cannot be
  /// displayed again. "Set on the 3rd of March" is what turns a column nobody
  /// can read into something a person can act on.
  phraseSetAt DateTime?
  name        String   @default("")
  picture     String   @default("")
  /// The invite code that let this member in, or blank when the operator did.
  invitedWith String   @default("")
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// When the operator shut this account, or null. A banned member's session
  /// stops working on their next request, and no invite code will let them
  /// back in; their games and their rating stay exactly as they are, because
  /// the people they played those games against played them too.
  bannedAt    DateTime?
  /// Why, kept for the operator alone. Never shown to the member.
  bannedNote  String   @default("")
  /// What other players may see, all optional: where they are, and when it is there.
  city        String   @default("")
  country     String   @default("")
  timeZone    String   @default("")
  bio         String   @default("")
  /// Listed among who is here, and mailed when it is their move.
  showOnline  Boolean  @default(true)
  emailNotify Boolean  @default(true)
  /// Away: deadlines in games that honour vacation days wait until this range is over.
  awayFrom     DateTime?
  awayUntil    DateTime?
  /// How this member likes a board dressed — the wood, the stones, the grid,
  /// the coordinates — so a phone and a laptop show the same board. Shaped
  /// like Appearance, but read back through cleanAppearance rather than
  /// trusted: a theme that has since been removed must not break a board.
  appearance Json?
  /// Where a new game starts for this member — board size, the switches
  /// under Advanced, the clock, whether it counts. A starting point only: a
  /// game already under way is never touched by it. Shaped like GameDefaults,
  /// and read back through cleanGameDefaults rather than trusted.
  gameDefaults Json?
  /// Standing choices with no column of their own: how the players page was
  /// last narrowed, and whatever is asked for next. One column rather than a
  /// row per preference, because it is read beside appearance on nearly every
  /// page and a join is not free. Shaped by the registry in lib/preferences
  /// and read back through cleanPreferences rather than trusted, for the same
  /// reason appearance is: a value written by a version that offered something
  /// this one does not falls back for that one field and leaves the rest
  /// alone. Null is "never chose anything". Appearance and gameDefaults stay
  /// as they are; folding them in is a later job.
  preferences Json?
  /// Days of the week this member does not play, 0 for Sunday. Standing,
  /// unlike the away range: deadlines in games that honour vacation step
  /// over them every week and nothing is spent. All seven is refused — that
  /// is not a preference, it is a game that could never end.
  daysOff Int[] @default([])
  /// How many days a finished game stays in this member's own list, or 0 to
  /// keep them all. It hides them from that list and from nowhere else: the
  /// record keeps every game, the ratings are untouched, and each game is
  /// still at its own address.
  keepFinishedDays Int @default(0)
  /// Vacation days spent this calendar year, against a flat allowance.
  awayDaysUsed Int      @default(0)
  awayYear     Int      @default(0)
  /// The grade a computer player plays at — see BOT_MEMBERS — or null for a
  /// person. A computer player is a member like any other: it holds a seat,
  /// it appears in the record, and its rating moves when somebody beats it.
  /// What this column adds is only that it is not a person, which the clock
  /// needs to know (a computer is never late) and the directory shows.
  botTier      String?

  /// The run over EVERY finished game this member has played here — rated or
  /// friendly, either pool, whoever held the other seat. The rule is
  /// `rating/streak.ts`, the same one the three runs on Player follow: a draw
  /// is its own streak, and null means no finished game rather than a run of
  /// nought.
  ///
  /// A FOURTH SCOPE BECAUSE THE COLUMN BESIDE IT IS A FOURTH SET OF GAMES.
  /// 0.147.1 fixed the PLAYED column to count every finished game — it had
  /// been counting rated ones under a heading that says played, and Andrus
  /// Meritalu read 1 where he had played 36. None of Player's three runs is
  /// that set, so the members list and a member's own line showed a dash
  /// rather than describe a rated run as a run over every game. This is the
  /// set they were missing.
  ///
  /// ON `Member` RATHER THAN `Player`, and the key is the reason. The number
  /// this run sits beside comes from `fetchPlayedTallies`, which matches by
  /// member id and never by name — production carries a decided game between
  /// "Meijin" and "Hidemasa Tamenoki" with both seats' ids null, and a name
  /// fallback would pull it into a total it was never bound to. `Player.key`
  /// is a FOLDED NAME (Hanachan's row is still keyed `hanako morris`) and a
  /// Player row only exists once a RATED game has been recorded, so most of a
  /// member's friendly games could reach no row at all. A member-keyed fact
  /// belongs on the member.
  ///
  /// MAINTAINED WHEREVER A GAME IS DECIDED, not only where one is rated:
  /// `recordPlayed` in `rating/playedRun.ts` is called from all four endings
  /// — a move, a claimed timeout, a position with no legal turn, and a
  /// resignation — and is deliberately not gated on `rated` or on hot seat,
  /// because neither of those tests is part of what PLAYED counts. A game
  /// called off before the first stone is `abandoned` and is not a result, so
  /// nothing is recorded for it.
  playedStreakKind  String?
  playedStreakCount Int @default(0)

  /// Every point this member has earned, denormalised from XpEvent.
  ///
  /// A COLUMN AND NOT A SUM, and the reason is the same one `playedStreakCount`
  /// gives: every list that shows a level shows it beside a name — the members
  /// directory, a ladder, the XP leaderboard — and a sum per row is the fault
  /// taken off the landing page in 0.139.0, where 2,508 move rows were read to
  /// draw eight games. Every one of those lists already fetches this row.
  ///
  /// Safe to denormalise because it is a SUM and not a formula. It can be
  /// recomputed from XpEvent and checked, and `awardXp` writes the event and
  /// this in one transaction, so a replayed request cannot drift them.
  ///
  /// THE LEVEL IS NOT STORED BESIDE IT. `xpLevelFor` is a lookup over a
  /// hundred-element array in memory, so a list that has this row has the level
  /// for nothing — and the curve is a table precisely so it can be retuned with
  /// no migration behind it. A stored level is a cached copy of that table, and
  /// the moment it is retuned every stored level is a number nobody can trust
  /// and nothing reports it.
  xp      Int   @default(0)

  /// XP earned that this member has not been shown yet.
  ///
  /// A courtesy, not a record — the ledger is XpEvent, and a missed toast is
  /// not a bug worth waking anybody for. It is a column because half the awards
  /// here have nobody waiting on a response: a visit is awarded during a server
  /// render, and a game finishes because the OPPONENT moved, or a bot did, or a
  /// clock ran out. There is no reply to put it in, and a cookie cannot be set
  /// during a render.
  ///
  /// Written by awardXp inside the transaction that writes the total, so it
  /// costs no write of its own; read off the row `memberRowFor` already fetches
  /// on every server-rendered page, so it costs no query; cleared by the toast
  /// host once it has been shown. See src/lib/xp/xpFlash.ts.
  xpFlash Json?

  /// When this member last earned anything. Null means never.
  ///
  /// A COLUMN BECAUSE THE LEADERBOARD SORTS BY IT. `max(createdAt)` per member
  /// is either a query per row — the fault taken off the landing page in
  /// 0.139.0 — or a grouped subquery that no index can order, which is a full
  /// scan of XpEvent every time somebody clicks the heading. Written by awardXp
  /// in the same update that increments `xp`, so it costs nothing.
  ///
  /// NULLABLE, and never a stand-in date. "Has never earned anything" is a real
  /// state a leaderboard wants to show differently, and `createdAt` or the epoch
  /// would both be dates somebody could mistake for a real one.
  xpLastAt DateTime?

  @@index([botTier])
  /// The XP leaderboard's default sort: highest first. The LEVEL is derived from
  /// this column and the curve is monotonic, so sorting by level is sorting by
  /// this — there is nothing to index for it, and nothing to store.
  @@index([xp])
  /// The leaderboard's other sort, and how "who is actually climbing" is read.
  @@index([xpLastAt])
}

/// One thing a member earned, once.
///
/// THE UNIQUE INDEX IS THE WHOLE DESIGN. A type plus a subject says how often an
/// award may happen — the day key for a daily one, the game id for a game, the
/// variant for a first play, "" for a once-ever — so idempotency is the schema's
/// job and not a rule every caller has to remember. A replayed request, a
/// double-fired handler and a bot replaying an ending all write the row that is
/// already there, and the second write is refused.
///
/// UmaKuma's XpEvent is one row per (account, kind, day) ACCUMULATED, which
/// answers a daily cap and a once-a-day award in one read and pays for it with
/// an XP_ONCE_PER_DAY list, an XP_DAILY_CAPS map, and per-award timing gone for
/// good. Putting the frequency in the subject buys all of that back with one
/// index.
///
/// NO RELATION TO Member, matching every other member-keyed table here
/// (Player.memberId, PlayerVariantRating.memberId, Game.blackMemberId): the id
/// is opaque, the join is never wanted, and production carries decided games
/// with null seat ids that a foreign key would have refused.
model XpEvent {
  id       String @id @default(cuid())
  memberId String
  /// The key in XP_EVENTS. Deliberately not a Prisma enum: a Postgres enum
  /// member cannot be renamed under rows that hold it, and this catalogue will
  /// grow — BacklogStatus carries three legacy values for exactly that reason.
  /// `XpEventType` in src/lib/xp/xp.types.ts is what keeps it honest.
  type     String
  /// What was actually paid, AT THE TIME. Not what the type is worth now:
  /// repricing an award must never rewrite anybody's history.
  points   Int
  /// What this award was about. "" for an award about nobody but the member.
  ///
  /// NOT NULLABLE, and the reason is the index above it: Postgres does not
  /// consider two nulls equal, so a nullable subject would let a once-ever
  /// award be paid twice — the index present, tested, and silently not doing
  /// the one job it exists for. "" is a real and distinct meaning here rather
  /// than a stand-in for a missing answer, which is what makes it the right
  /// answer and not a value that happens to be in range.
  subject  String @default("")
  /// The day it was earned, in the member's own zone where they have set one.
  /// A column rather than something derived from createdAt, so the day's
  /// allowance is one indexed count and a history page needs no arithmetic.
  dayKey   String
  createdAt DateTime @default(now())

  @@unique([memberId, type, subject])
  /// The day's allowance: one count, one index.
  @@index([memberId, dayKey])
  /// A member's own history, newest first.
  @@index([memberId, createdAt])
}

/// Courtesy time one seat gave the other during a game, kept so sportsmanship can be read later.
model TimeGift {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// The colour that gave the time; the other colour received it.
  giver     String
  givenMs   Int
  createdAt DateTime @default(now())

  @@index([gameId])
}

/// A request to be paired with anyone who wants the same game at the same pace.
/// Unused since 0.54.0, when starting a game became one sentence: a request
/// with nobody to pair against is a posted seat now, which everyone can see.
/// Kept until it is certain nothing is waiting in it, then dropped.
model AutoMatchRequest {
  id         String   @id @default(cuid())
  member     String
  variant    String
  /// Per-move time limit in milliseconds, or null for none; a pairing must agree on it.
  moveTimeMs Int?
  createdAt  DateTime @default(now())

  @@index([variant, moveTimeMs, createdAt])
  @@index([member])
}

/// A member's ignore list: a member who may not challenge the owner.
model Ignore {
  owner     String
  ignored   String
  createdAt DateTime @default(now())

  @@id([owner, ignored])
  @@index([ignored])
}

/// A member's buddy list: one row per pair, owner to buddy, by email.
model Buddy {
  owner     String
  buddy     String
  createdAt DateTime @default(now())

  @@id([owner, buddy])
  @@index([buddy])
}

/// Where a wanted thing stands.
///
/// The five are the questions actually asked about a request, in order: has
/// anyone asked for it, has it been agreed, is somebody on it, is it in, was
/// it decided against. `dropped` is a status rather than a deletion, because
/// "we talked about that and said no" is the answer a board most often has to
/// give twice.
/// How much a thing matters, when somebody has said.
enum BacklogPriority {
  high
  normal
  low
}

/// How much work a thing is, and how much can go wrong doing it. Risk lives
/// here rather than in a third column: three axes on a board nobody fills in
/// is worse than two that get used.
enum BacklogEffort {
  small
  medium
  large
}

enum BacklogStatus {
  open
  inProgress
  done
  dropped

  /// The three the board used to have. `proposed` and `planned` were the same
  /// thing — asked for, nobody on it — because there is no gap here between
  /// agreeing to something and starting it, so `planned` was empty every day
  /// it existed. `building` is what `inProgress` says plainly.
  ///
  /// Kept in the type rather than dropped with the rows so that new code can
  /// read an old row: the deploy goes out before the migration, reads the old
  /// values through `statusFrom`, and shows them in the right column before
  /// anything is rewritten. Removing them is a separate migration, once no row
  /// has said one of them for long enough to be sure.
  proposed
  planned
  building
}

/// What sort of thing was asked for. A board that mixes "add Go" with "the
/// move scrubber skips a move" reads as noise unless every line says which
/// of the two it is.
enum BacklogKind {
  feature
  fix
  chore
}

/// One thing somebody asked for.
///
/// Until this table there was no such thing as a request here: features and
/// faults were raised in conversation and lived only there, so the answer to
/// "what did I ask for" was whoever had scrolled back furthest. A row is the
/// request itself — addressable, countable, and still there next week.
model BacklogItem {
  id  String @id @default(cuid())
  /// A stable kebab-case name, unique across the board. It is what makes
  /// seeding idempotent — the starter set carries its own keys, so seeding a
  /// database that already holds them changes nothing — and it gives a commit
  /// message or a chat something short to cite.
  key String @unique

  title  String
  /// The longer telling: what was asked for, and anything settled since. May
  /// be empty; a one-line request is still a request.
  detail String @default("")

  kind   BacklogKind   @default(feature)

  /// How much this matters and how much work it is, once somebody has judged
  /// it. Two axes because they are independent — a valuable hard thing and a
  /// trivial easy thing are the same number on one axis, and telling those
  /// apart is the point of grading at all.
  ///
  /// Null until graded, with no default on purpose: "normal" for everything
  /// would be a judgement nobody made, written onto every row, and unreadable
  /// afterwards from one somebody did make.
  priority BacklogPriority?
  effort   BacklogEffort?
  status BacklogStatus @default(open)

  /// Who asked, as free text. Requests arrive in chat, in a game, or from the
  /// owner himself, and most have no account behind them; a name here is worth
  /// more than a relation that would usually be null.
  askedBy String  @default("")
  /// The member who typed the row in, by email, when a signed-in one did.
  addedBy String?
  /// Who holds this and since when. In progress is not a status here, it is
  /// this pair: a hold nobody has renewed inside the lease (six hours, see
  /// backlog.ts) is free again, or one crashed session takes a row out of
  /// circulation for good. Free text, for the same reason askedBy is free
  /// text — the people working on this are not all accounts here. Both null
  /// together mean nobody has it, and a mover writes them together always;
  /// nothing sets one without the other.
  claimedBy String?   @db.VarChar(80)
  claimedAt DateTime?

  createdAt DateTime @default(now())
  /// When the status last changed — deliberately not "when the row was last
  /// written". The board is read as "what has moved", and fixing a typo in a
  /// title is not movement, so @updatedAt would answer a different question.
  movedAt   DateTime @default(now())
  /// The version that was running when this row was marked done, stamped as
  /// the move happens and cleared if it ever leaves done again.
  ///
  /// Stamped rather than worked out afterwards, because it cannot be worked
  /// out. The changelog lists 126 releases and dates none of them, so there
  /// is nothing for a date to fall between; and the releases that can be
  /// dated at all are thirty-six that landed on one day, which day
  /// granularity could not tell apart even if the dates were there.
  ///
  /// Null for every row finished before this column existed, and left that
  /// way on purpose — a release invented for them would be a fact nobody
  /// established, which is worse than an empty space that admits it.
  releasedIn String?
  /// The instant of the release that carried this, written by the release
  /// tool beside releasedIn (see board-convergence ITS-04). Null for every
  /// row finished before it existed, and for every row that is not done.
  releasedAt DateTime?
  updatedAt DateTime @updatedAt

  /// The board's own ordering: one status at a time, most recently moved first.
  @@index([status, movedAt])
  @@index([createdAt])
}
