{
  "name": "itsutsu",
  "version": "0.322.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-6700}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-6700}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "loc:check": "node scripts/check-max-loc.mjs",
    "functions:size": "node scripts/check-function-sizes.mjs",
    "attribution:check": "node scripts/check-attribution.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "quality:check": "pnpm lint && pnpm loc:check && pnpm typecheck && pnpm test:unit",
    "quality:fix": "pnpm lint:fix && pnpm quality:check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "local:db:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "local:db:down": "docker compose -f docker-compose.local.yml down",
    "local:db:reset": "docker compose -f docker-compose.local.yml down -v && pnpm local:db:up && pnpm db:deploy",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "playwright test e2e/screenshots.spec.ts --reporter=line",
    "favicon": "node scripts/make-favicon.mjs",
    "brand:rasters": "node scripts/make-brand-rasters.mjs",
    "art:faces": "node scripts/make-bot-faces.mjs",
    "art:thumbs": "node scripts/make-game-thumbs.mjs",
    "security:check": "pnpm audit --prod --audit-level high",
    "db:drift:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code --script",
    "preflight:prod": "node scripts/preflight.mjs",
    "invite": "node --env-file=.env scripts/mint-invite.ts",
    "embed-token": "node --env-file=.env scripts/mint-embed-token.ts",
    "task": "node --env-file=.env scripts/tasks.ts",
    "task:prod": "SUMILABU_PROJECT_KEY=itsutsu SUMILABU_LIVE_OPT_IN=task:prod node --env-file=.env scripts/tasks.ts",
    "release:take": "node --env-file=.env scripts/release-take.ts",
    "release:take:prod": "SUMILABU_PROJECT_KEY=itsutsu SUMILABU_LIVE_OPT_IN=release:take:prod node --env-file=.env scripts/release-take.ts",
    "screenshots:games": "GAME_SCREENSHOTS=1 playwright test e2e/game-screenshots.spec.ts --reporter=line && node scripts/make-game-thumbs.mjs && node scripts/board-art-stamp.ts",
    "screenshots:puzzles": "GAME_SCREENSHOTS=1 playwright test e2e/puzzle-screenshots.spec.ts --reporter=line && node scripts/make-game-thumbs.mjs && node scripts/puzzle-art-stamp.ts",
    "bots:budget": "BOT_BUDGET=1 vitest run src/lib/bots/botBudget.play.test.ts --disable-console-intercept",
    "bots:grades": "BOT_GRADES=1 vitest run src/lib/bots/botGrades.play.test.ts --disable-console-intercept",
    "bots:perfect": "BOT_PERFECT=1 vitest run src/lib/bots/botPerfect.play.test.ts --disable-console-intercept",
    "bots:threats": "BOT_THREATS=1 vitest run src/lib/gomoku/threatWin.play.test.ts --disable-console-intercept",
    "bots:gomocup": "vitest run src/lib/bots/gomocupMatch.play.test.ts --disable-console-intercept",
    "bots:eval-games": "vitest run src/lib/bots/evalGames.play.test.ts --disable-console-intercept",
    "bots:eval-tune": "vitest run src/lib/bots/evalTune.play.test.ts --disable-console-intercept",
    "bots:play": "BOT_GAMES=1 vitest run src/lib/bots/botSeries.play.test.ts --disable-console-intercept",
    "bots:play:prod": "node scripts/bots-play-prod.mjs",
    "board:export": "node --env-file-if-exists=.env scripts/board-export.ts",
    "board:export:prod": "node scripts/board-export-prod.mjs",
    "rated:audit": "RATED_AUDIT=1 vitest run src/lib/rating/ratedButRefused.play.test.ts --disable-console-intercept",
    "xp:backfill": "XP_BACKFILL=1 vitest run src/lib/xp/backfillXp.play.test.ts --disable-console-intercept",
    "standings:reconcile": "STANDINGS_RECONCILE=1 vitest run src/lib/rating/reconcileStandings.play.test.ts --disable-console-intercept",
    "site-settings:copy": "SITE_SETTINGS_COPY=1 vitest run src/lib/site/siteSettingsCopy.play.test.ts --disable-console-intercept",
    "site-settings:copy:prod": "node scripts/site-settings-copy-prod.mjs",
    "xp:backfill:prod": "node scripts/xp-backfill-prod.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "description": "Gomoku (五目並べ) — five in a row on a go board.",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
