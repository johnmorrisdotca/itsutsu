{
  "name": "kyuubu",
  "version": "0.1.0",
  "description": "A turning cube for the browser: 2×2 to 7×7, in CSS 3D, turned by drag, mouse wheel, touch or cubers' notation. No framework needed; a small React wrapper included.",
  "keywords": [
    "cube",
    "rubiks-cube",
    "speedcubing",
    "puzzle",
    "css-3d",
    "twisty-puzzle",
    "react"
  ],
  "author": "John Morris <john@johnmorris.ca>",
  "license": "MIT",
  "homepage": "https://johnmorrisdotca.github.io/kyuubu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kyuubu.git"
  },
  "bugs": "https://github.com/johnmorrisdotca/kyuubu/issues",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-esm.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "pnpm build && node demo/stage.mjs",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0"
}
