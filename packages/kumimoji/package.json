{
  "name": "@johnmorrisdotca/kumimoji",
  "version": "0.1.0",
  "description": "Kumimoji 組み文字: the race to build a crossword from a bag of letter tiles, in English or Japanese, alone or at a table of two to eight. Seeded deals, word checking, wild tiles, trades, a computer player, a plain-DOM table and React views.",
  "license": "MIT",
  "author": "John Morris <john@johnmorris.ca>",
  "homepage": "https://johnmorrisdotca.github.io/kumimoji/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kumimoji.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kumimoji/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/words.js",
    "./dist/tileWordsModule.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "word-game",
    "crossword",
    "tiles",
    "anagram",
    "japanese",
    "kana",
    "game-engine",
    "seeded",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./words": {
      "types": "./dist/words.d.ts",
      "import": "./dist/words.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "site": "pnpm run build && node scripts/site.mjs",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.11.0"
}
