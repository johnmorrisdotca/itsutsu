{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Node runs scripts/*.ts directly by stripping types, so an import there
    // has to name the .ts file it means. Safe with noEmit: nothing is emitted
    // that could carry the extension into a build.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // The playing cards and the family card games are Toranpu, an open-source
      // package kept here until it has a repository of its own; imported by name
      // so that day changes no import. Each game is its own entry point.
      "@johnmorrisdotca/toranpu": ["./packages/toranpu/src/index.ts"],
      "@johnmorrisdotca/toranpu/*": ["./packages/toranpu/src/*.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
