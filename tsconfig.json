{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Node runs scripts/*.ts directly by stripping types, so an import there
    // has to name the .ts file it means. Safe with noEmit: nothing is emitted
    // that could carry the extension into a build.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // Seeded random and daily seeds are their own open-source package, Tane,
      // kept here until it is on npm; imported by name so that day changes no import.
      "@johnmorrisdotca/tane": ["./packages/tane/src/index.ts"],
      "@johnmorrisdotca/tane/react": ["./packages/tane/src/react.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "packages/*/node_modules", "packages/*/dist", "packages/*/site"]
}
